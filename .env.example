# Defaults match docker-compose.yml; the Makefile uses them when these are unset.
DATABASE_URL=postgresql://firm_payments:firm_payments@localhost:5432/firm_payments
TEST_DATABASE_URL=postgresql://firm_payments:firm_payments@localhost:5432/firm_payments_test

# Host ports published by docker compose. Change them if 5432 or 8000 is taken.
POSTGRES_PORT=5432
APP_PORT=8000
# App instances behind the load balancer.
APP_REPLICAS=2
